# CyberSentinel AI public configuration template.
# Copy this file to `.env`, then replace placeholder values with your own.
# Keep `.env` private. It is intentionally ignored by git.

# Runtime
# Monitoring loop interval in seconds. Default: 7200.
MONITOR_INTERVAL=7200

# SQLite database path. Relative paths are resolved from the project root.
DATABASE_PATH=cve_database.db

# Primary OpenAI-compatible provider.
# Leave PRIMARY_AI_KEY empty if you only want to run tests or inspect the project.
PRIMARY_AI_KEY=
PRIMARY_AI_BASE=https://api.openai.com/v1
PRIMARY_AI_MODEL=gpt-4.1-nano

# Backup OpenAI-compatible providers.
# JSON array format:
# [{"api_key":"replace-with-backup-key","api_base":"https://api.example.com/v1","model":"model-name"}]
BACKUP_AI_CONFIGS=[]

# Gemini provider.
# Leave GEMINI_AI_KEY empty if Gemini fallback is not used.
GEMINI_AI_KEY=
GEMINI_AI_MODEL=gemini-2.5-flash
GEMINI_AI_BASE_URL=https://generativelanguage.googleapis.com

# GitHub API credentials.
# Recommended for real monitoring because unauthenticated GitHub requests are heavily rate limited.
# Use either GITHUB_TOKENS as a JSON array or GITHUB_TOKEN as a single fallback token.
GITHUB_TOKENS=[]
GITHUB_TOKEN=

# Optional blog publishing integration.
# Leave BLOG_TOKEN empty to keep report generation local only.
BLOG_BASE_URL=http://127.0.0.1
BLOG_TOKEN=
